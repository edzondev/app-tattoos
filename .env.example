# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Connection string used by Drizzle at runtime
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Secret used to sign sessions and tokens — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="your-secret-here"

# Base URL of the app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# ─── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated list of email addresses allowed to access /admin
# Example: "admin@example.com,owner@example.com"
ADMIN_EMAIL_ALLOWLIST="admin@example.com"

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
# Cloudflare account ID (found in the R2 dashboard URL)
R2_ACCOUNT_ID="your-cloudflare-account-id"

# R2 API credentials (create an API token with Object Read & Write permissions)
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# R2 bucket name
R2_BUCKET="your-bucket-name"

# Public base URL for R2 objects — either the R2 public domain or a custom domain
# No trailing slash. Example: "https://pub-xxxx.r2.dev" or "https://cdn.yourdomain.com"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"

# ─── Google AI (Gemini via AI SDK) ────────────────────────────────────────────
# API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"

# ─── Preview generation ───────────────────────────────────────────────────────
# Maximum AI designs per tattoo request (1–2, default 2)
PREVIEW_GENERATION_LIMIT=2

# ─── Public client-side variables ────────────────────────────────────────────
# WhatsApp number used in the confirmation screen "Seguir por WhatsApp" button
# Must include country code without + (e.g. Perú: 51XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER="51999888777"


RESEND_API_KEY=""
